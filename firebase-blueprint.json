{
  "entities": {
    "Customer": {
      "title": "Customer",
      "description": "Salon customer profile with contact information and preferences",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "name": {
          "type": "string",
          "description": "Customer full name"
        },
        "phoneNo": {
          "type": "string",
          "description": "Customer contact phone number"
        },
        "dob": {
          "type": "string",
          "description": "Customer date of birth (YYYY-MM-DD)"
        },
        "email": {
          "type": "string",
          "description": "Customer email address"
        },
        "address": {
          "type": "string",
          "description": "Customer physical address"
        },
        "preferredStylist": {
          "type": "string",
          "description": "Preferred hair stylist or aesthetician"
        },
        "notes": {
          "type": "string",
          "description": "Customer specific preferences, allergies, or styling notes"
        },
        "totalVisits": {
          "type": "integer",
          "description": "Total completed appointments/visits"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Document creation timestamp (FieldValue.serverTimestamp)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Document last updated timestamp (FieldValue.serverTimestamp)"
        }
      },
      "required": ["userId", "name", "phoneNo", "email", "createdAt", "updatedAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Salon service booking details for a customer",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "customerId": {
          "type": "string",
          "description": "Associated customer document ID"
        },
        "customerName": {
          "type": "string",
          "description": "Customer full name snapshot"
        },
        "customerPhone": {
          "type": "string",
          "description": "Customer contact phone snapshot"
        },
        "serviceName": {
          "type": "string",
          "description": "Salon service booked"
        },
        "price": {
          "type": "integer",
          "description": "Service price in USD"
        },
        "stylist": {
          "type": "string",
          "description": "Stylist assigned to the booking"
        },
        "appointmentDate": {
          "type": "string",
          "description": "Date of the appointment (YYYY-MM-DD)"
        },
        "appointmentTime": {
          "type": "string",
          "description": "Time of the appointment (HH:MM)"
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Confirmed", "Completed", "Cancelled"],
          "description": "Status of the salon appointment"
        },
        "notes": {
          "type": "string",
          "description": "Booking notes or customer special requests"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp (FieldValue.serverTimestamp)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp (FieldValue.serverTimestamp)"
        }
      },
      "required": ["userId", "customerName", "serviceName", "appointmentDate", "appointmentTime", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "Salon customers registered under the authenticated user account"
    },
    "/users/{userId}/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Salon service appointments booked under the authenticated user account"
    }
  }
}
